{
  "name": "recipes-for-posterity",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "lint": "eslint .",
    "emulators": "firebase emulators:start",
    "test:rules": "firebase emulators:exec --only firestore \"vitest run tests\"",
    "seed:emulator": "cross-env FIRESTORE_EMULATOR_HOST=127.0.0.1:8080 tsx scripts/seedFirestoreRecipes.ts"
  },
  "dependencies": {
    "firebase": "^12.18.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.15.0",
    "@firebase/rules-unit-testing": "^5.0.2",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.3",
    "cross-env": "^10.1.0",
    "eslint": "^9.15.0",
    "eslint-plugin-react-hooks": "^5.0.0",
    "eslint-plugin-react-refresh": "^0.4.14",
    "firebase-admin": "^14.3.0",
    "tsx": "^4.23.13",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.15.0",
    "vite": "^6.0.1",
    "vitest": "^4.1.11"
  }
}
